# ---------------------------------------------------------------------------
# EL PARCHE — backend (server/)
# Copia este archivo a `server/.env` y ajusta. NO subas `server/.env` al repo.
# ---------------------------------------------------------------------------

# Puerto del backend
PORT=8787

# URL pública del backend (para construir la URL del checkout)
PUBLIC_URL=http://localhost:8787

# URL del frontend (a dónde vuelve ePayco tras pagar)
APP_URL=http://localhost:5180

# Ruta del archivo SQLite (por defecto server/data/parche.sqlite)
# DB_PATH=./server/data/parche.sqlite

# ------------------------------- ePayco ------------------------------------
# test = firma y respuestas simuladas (sin llaves). live = cobros reales.
EPAYCO_MODE=test

# Solo para EPAYCO_MODE=live. Estas llaves NUNCA van al frontend.
# P_CUST_ID_CLIENTE=tu_cust_id_cliente
# P_KEY=tu_p_key
# PUBLIC_KEY=tu_llave_publica
