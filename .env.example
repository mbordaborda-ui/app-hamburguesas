# ---------------------------------------------------------------------------
# EL PARCHE — frontend (Vite)
# Copia este archivo a `.env.local` y ajusta. NO lo subas al repo.
# ---------------------------------------------------------------------------

# Backend de pagos/pedidos (carpeta server/). Si está definido, los pagos usan
# ePayco real (o simulado por el backend). El resto de datos siguen en modo local.
VITE_PAYMENTS_API_URL=http://localhost:8787

# Backend completo (opcional). Si se define, TODA la app pasa a modo remoto.
# VITE_API_URL=https://api.elparche.co
